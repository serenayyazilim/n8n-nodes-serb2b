{
  "name": "n8n-nodes-serb2b",
  "version": "0.1.0",
  "description": "n8n nodes for SerB2B e-commerce platform",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "serb2b",
    "ecommerce",
    "e-commerce",
    "workflow",
    "automation",
    "integration"
  ],
  "license": "MIT",
  "homepage": "https://github.com/serenayyazilim/n8n-nodes-serb2b",
  "author": {
    "name": "SerB2B",
    "email": "support@serb2b.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serenayyazilim/n8n-nodes-serb2b.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run build:icons",
    "build:icons": "cp nodes/**/*.svg dist/nodes/SerB2B/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SerB2BApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SerB2B/SerB2B.node.js",
      "dist/nodes/SerB2B/SerB2BTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^5.29.0",
    "n8n-workflow": "~1.0.0",
    "prettier": "^2.7.1",
    "typescript": "~4.9.5"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  }
}